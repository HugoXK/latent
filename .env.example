# Latent — environment
#
# Copy to .env and fill in your own values. Never commit .env.
# The runtime that reads these variables lands in v0.2; this file documents the
# intended contract today.

# --- Server -----------------------------------------------------------------
LATENT_BASE_URL=http://127.0.0.1:4310
LATENT_PORT=4310
LATENT_LOG_LEVEL=info
LATENT_TELEMETRY=off

# --- Storage ----------------------------------------------------------------
# Single-writer SQLite. The blob directory is content-addressed.
LATENT_DB_PATH=./data/runtime/latent.sqlite
LATENT_BLOB_DIR=./data/runtime/blobs

# Master key for AES-256-GCM at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Prefer the OS keychain; this variable is a fallback for headless installs.
LATENT_MASTER_KEY=

# --- Reconstruction ---------------------------------------------------------
# template = deterministic offline adapter (default); model = OpenAI-compatible.
LATENT_RECONSTRUCTOR=template

# --- Model provider (OpenAI-compatible) --------------------------------------
# A private fragment is sent only when this provider is explicitly enabled.
LATENT_MODEL_PROVIDER=openai-compatible
LATENT_MODEL_BASE_URL=
LATENT_MODEL_API_KEY=
LATENT_MODEL_NAME=
LATENT_MODEL_JSON_MODE=true
LATENT_MODEL_SEND_PRIVATE=false

# --- Search / retrieval ------------------------------------------------------
LATENT_SEARCH_PROVIDER=local
LATENT_SEARCH_ENDPOINT=

# --- Runtime (optional adapter) ---------------------------------------------
# FlyBot or another runtime. Empty means the local scheduler.
LATENT_RUNTIME=none
LATENT_RUNTIME_URL=
LATENT_RUNTIME_TOKEN=

# --- Evolution and calibration (offline only) -------------------------------
LATENT_EVOLVER=none
LATENT_CALIBRATOR=local

# --- Research tools (science verticals only) --------------------------------
LATENT_RESEARCH_TOOLS=none

# --- Budget ----------------------------------------------------------------
# Per-job and per-day budget in CNY. A hard stop; overage needs a human action.
LATENT_JOB_BUDGET_CNY=1
LATENT_DAILY_BUDGET_CNY=10
