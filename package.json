{
  "name": "latent",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "dev": "tsx apps/server/src/index.ts",
    "latent": "tsx apps/cli/src/index.ts",
    "schema:types": "tsx scripts/generate-schema-types.ts",
    "schema:types:check": "tsx scripts/generate-schema-types.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
