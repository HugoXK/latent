{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/replay-case.schema.json",
  "title": "ReplayCase",
  "description": "A blind replay case. The input fields are shown to the system; expected_candidates, collisions and outcome are hidden and used only for scoring.",
  "type": "object",
  "required": [
    "metadata",
    "constraints",
    "fragment",
    "prior_art",
    "expected_candidates",
    "collisions",
    "gate_labels",
    "outcome"
  ],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "constraints": {
      "$ref": "https://latent.dev/schemas/constraint-state.schema.json"
    },
    "fragment": {
      "$ref": "https://latent.dev/schemas/fragment.schema.json"
    },
    "prior_art": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/priorArt" }
    },
    "expected_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "collisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/collision" }
    },
    "gate_labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gateLabel" }
    },
    "outcome": { "$ref": "#/$defs/outcome" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "vertical",
        "season",
        "village",
        "illustrative",
        "temporal_cutoff",
        "created_at",
        "owner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^replay_[a-z0-9-]{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "vertical": { "type": "string", "minLength": 1 },
        "season": { "type": "integer", "minimum": 2003 },
        "village": { "type": "string", "minLength": 1 },
        "illustrative": { "type": "boolean" },
        "temporal_cutoff": { "type": "string", "format": "date" },
        "created_at": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "priorArt": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "year",
        "url",
        "published_at",
        "mechanism",
        "interface",
        "source_grade"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^pa_[a-z0-9-]{2,}$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["project", "part", "paper"] },
        "year": { "type": "integer", "minimum": 2003 },
        "url": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date" },
        "mechanism": { "type": "string", "minLength": 1 },
        "interface": { "type": "string", "minLength": 1 },
        "source_grade": { "enum": ["A", "B", "C"] }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "variant",
        "mechanism",
        "interface",
        "host",
        "readout",
        "is_seed"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^cand_[a-z0-9-]{2,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "variant": { "enum": ["conservative", "ambitious", "cross_domain"] },
        "mechanism": { "type": "string", "minLength": 1 },
        "interface": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "readout": { "type": "string", "minLength": 1 },
        "is_seed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "collision": {
      "type": "object",
      "required": ["id", "kind", "prior_art_id", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^col_[a-z0-9-]{2,}$" },
        "kind": { "enum": ["mechanism", "interface", "sequence"] },
        "prior_art_id": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gateLabel": {
      "type": "object",
      "required": ["gate", "expected", "rationale"],
      "properties": {
        "gate": { "type": "string", "minLength": 1 },
        "expected": { "enum": ["pass", "fail", "unknown"] },
        "rationale": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["hidden", "seed_title", "decision", "evidence"],
      "properties": {
        "hidden": { "const": true },
        "seed_title": { "type": "string", "minLength": 1 },
        "seed_doi": { "type": ["string", "null"] },
        "decision": {
          "enum": ["shipped", "tested", "parked", "killed", "failed"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
