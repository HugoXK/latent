{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.dev/schemas/claim.schema.json",
  "title": "Claim",
  "description": "A statement with value, unit, conditions, sources, status and confidence.",
  "type": "object",
  "required": ["id", "text", "status", "confidence", "confidence_basis", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^clm_[a-z0-9]{8,}$" },
    "text": { "type": "string", "minLength": 1 },
    "value": { "type": ["number", "string", "null"] },
    "unit": { "type": ["string", "null"] },
    "conditions": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "status": {
      "enum": ["verified", "inferred", "unsupported", "unknown", "contradicted"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_basis": { "enum": ["A", "B", "C", "expert"] },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "contradictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "verifier": { "type": ["string", "null"] },
    "schema_version": { "const": "1.0.0" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "url", "accessed_at"],
      "properties": {
        "kind": {
          "enum": ["paper", "registry", "wiki", "dataset", "web", "expert", "experiment"]
        },
        "url": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "span": {
          "type": ["string", "null"],
          "description": "The exact supporting span, not just a URL."
        },
        "snapshot_hash": { "type": ["string", "null"] },
        "accessed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
