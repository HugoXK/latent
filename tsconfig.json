{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@latent/core": ["packages/core/src/index.ts"],
      "@latent/store": ["packages/store/src/index.ts"],
      "@latent/adapters": ["packages/adapters/src/index.ts"],
      "@latent/vertical-igem": ["packages/vertical-igem/src/index.ts"],
      "@latent/retrieval": ["packages/retrieval/src/index.ts"],
      "@latent/novelty": ["packages/novelty/src/index.ts"],
      "@latent/client": ["packages/client/src/index.ts"],
      "@latent/vertical-research": ["packages/vertical-research/src/index.ts"],
      "@latent/verticals": ["packages/verticals/src/index.ts"]
    }
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "apps/**/src/**/*.ts",
    "apps/**/test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
